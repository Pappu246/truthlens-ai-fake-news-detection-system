{
  "schema_version": 1,
  "benchmark_id": "openweb-external",
  "record_fields": {
    "claim_id": "stable unique string",
    "claim": "verbatim claim under evaluation",
    "claim_date": "ISO date or null",
    "label": "SUPPORTED | REFUTED | INSUFFICIENT_EVIDENCE | CONFLICTED",
    "evidence": [
      {
        "url": "canonical source URL",
        "publisher": "source publisher",
        "published_at": "ISO timestamp or null",
        "retrieved_at": "ISO timestamp",
        "passage": "exact human-verified passage supporting the label",
        "relation": "SUPPORTS | REFUTES | CONTEXT_ONLY"
      }
    ],
    "annotation": {
      "annotator_id": "pseudonymous reviewer id",
      "second_annotator_id": "pseudonymous independent reviewer id",
      "agreement": "AGREE | ADJUDICATED",
      "adjudicator_id": "required when agreement is ADJUDICATED"
    }
  },
  "sealing_rules": {
    "minimum_claims": 300,
    "independent_annotation_required": true,
    "model_tuning_after_seal_forbidden": true,
    "retrieval_sources_must_be_recorded": true,
    "evidence_urls_must_be_canonicalized": true,
    "hash_claim_file_before_evaluation": true,
    "hash_evidence_file_before_evaluation": true
  }
}