{
  "schema_version": 1,
  "required_top_level": [
    "protocol_version",
    "benchmark_id",
    "dataset",
    "model",
    "metrics",
    "provenance"
  ],
  "required_dataset_fields": [
    "name",
    "version_or_split",
    "evaluation_count"
  ],
  "required_provenance_fields": [
    "commit_sha",
    "generated_at",
    "configuration_sha256"
  ],
  "rules": {
    "claims_sha256_must_be_64_hex": true,
    "corpus_sha256_must_be_64_hex_when_present": true,
    "authoritative_checksum_or_immutable_revision_required": true,
    "configuration_sha256_must_be_64_hex": true,
    "metric_values_must_be_numbers": true,
    "benchmark_id_must_exist_in_registry": true,
    "world_leading_claim_not_permitted_in_artifact": true
  }
}