{
  "name": "truthlens-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:contracts": "tsx scripts/contractTests.ts",
    "test:vercel-sim": "tsx scripts/vercel-sim.ts",
    "test:verdicts": "tsx scripts/regressionVerdictTests.ts",
    "train:claim": "python3 scripts/train_liar_claim.py",
    "test:claim": "tsx scripts/claimModelTests.ts",
    "test:claim-parity": "tsx scripts/claimParity.ts",
    "test:evidence": "tsx scripts/evidenceTests.ts",
    "test:artifacts": "tsx scripts/test_artifact_lifecycle.ts",
    "test:ssrf": "tsx scripts/ssrfTests.ts",
    "test:all": "npm run lint && npm run test:contracts && npm run test:vercel-sim && npm run test:verdicts && npm run test:claim && npm run test:claim-parity && npm run test:evidence && npm run test:artifacts && npm run test:ssrf",
    "test:production": "tsx scripts/productionSmokeTest.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
